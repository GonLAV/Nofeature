# Mode: BACKTEST | PAPER | LIVE. Default PAPER. LIVE is refused until a live
# broker adapter exists (Phase 10) AND both switches below are set.
TRADER_MODE=PAPER
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=

# Risk profile: CONSERVATIVE | NORMAL | AGGRESSIVE | EXTREME (default AGGRESSIVE)
RISK_PROFILE=AGGRESSIVE

# Never use paid data/services when true (default true)
ZERO_COST_MODE=true

BROKER=paper
BROKER_ACCOUNT_ID=PAPER-000001
TRADER_DB_PATH=trader.db

UNIVERSE=SPY,QQQ,IWM
BENCHMARK_SYMBOL=SPY

# SEC EDGAR requires a descriptive User-Agent with a contact email
SEC_USER_AGENT=

# Optional: required if the dashboard listens on anything but localhost
DASHBOARD_TOKEN=

LOG_LEVEL=WARNING
